{
  "expo": {
    "name": "Trail Atlas",
    "slug": "trail-atlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1f1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cc.glanger.trail-atlas",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "爬山时需要 GPS 记录轨迹",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "后台录制轨迹时需要持续 GPS 权限",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1f1a"
      },
      "package": "cc.glanger.trailatlas",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "scheme": "trail-atlas",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "爬山时需要 GPS 记录轨迹",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
